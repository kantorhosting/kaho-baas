PORT=8080
APP_ENV=local

# When running with docker compose, DB_HOST and DB_PORT are overridden
# to point at the "db" service.
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=kaho
DB_USERNAME=kaho
DB_PASSWORD=change-me
DB_SCHEMA=public

# Host port for Postgres in docker-compose.dev.yml
DB_EXPOSE_PORT=5432
